# Daher Health — public reverse proxy (DH-016)
#
# Subdomains, not path prefixes (ADR-008). Path-prefix routing breaks both
# applications: OpenMRS O3's SPA and OpenELIS's SPA each assume they own the
# root, and rewriting their asset paths is a permanent maintenance tax.
#
# Caddy is the ONLY container publishing host ports. Everything else stays on
# the internal Docker network. The O3 gateway container is kept and proxied to,
# rather than replaced (ADR-010).
#
# ⚠️ WITH BASE_DOMAIN=localhost this uses Caddy's INTERNAL CA — a locally
# trusted certificate, not a public one. Publicly trusted certificates require
# the facility's real domain with DNS pointing at the pilot VM (NEEDS LIBAN
# #15). Local HTTPS here proves routing, origins, and cookie behaviour; it does
# NOT prove public certificate issuance, and this file must not be read as
# though it did.

{
	# No admin API: it is unauthenticated by default and this container is the
	# only one exposed to the host.
	admin off

	# ⚠️ No global `email` directive here on purpose. Caddy fails to PARSE this
	# file if `email` is present with an empty value, which takes the whole proxy
	# down rather than degrading — verified 2026-08-13. ACME does not require an
	# address. When the real domain arrives (NEEDS LIBAN #15), add:
	#     email your-ops-address@example.org
	# so expiry warnings reach a human.
}

# ---------------------------------------------------------------------------
# Shared hardening. These are transport/proxy concerns only — nothing here
# makes a clinical decision or inspects clinical content.
# ---------------------------------------------------------------------------
(common) {
	encode zstd gzip

	header {
		# The pilot is HTTPS-only once behind Caddy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# Clinical records must not be framable by another origin.
		X-Frame-Options "SAMEORIGIN"
		# Caddy's own identity is not useful to a client and is useful to a scanner.
		-Server
	}
}

# ---------------------------------------------------------------------------
# emr.<domain> — OpenMRS O3.
#
# Proxied to the distro's own gateway container, which already routes the SPA
# and the backend consistently (ADR-010). Do not split those here; the gateway
# owns that mapping and its nginx template hard-codes the upstream names.
# ---------------------------------------------------------------------------
emr.{$BASE_DOMAIN} {
	import common
	reverse_proxy openmrs-gateway:80
}

# ---------------------------------------------------------------------------
# lab.<domain> — OpenELIS.
#
# ⚠️ The SPA and the API MUST share one origin. Verified 2026-08-13 by reading
# the built bundle: it calls `/OpenELIS-Global/...` as a RELATIVE path, and its
# nginx serves static files only with no API proxy of its own. Splitting these
# across two hostnames breaks every API call the SPA makes.
#
# The API leg speaks HTTPS to Tomcat on 8443 and is VERIFIED, not skipped:
# DH-021 generates that certificate on this deployment and exports its PEM, so
# the proxy has a real trust anchor. `tls_insecure_skip_verify` would mean the
# hop between the public edge and the clinical backend was unauthenticated.
# ---------------------------------------------------------------------------
lab.{$BASE_DOMAIN} {
	import common

	handle /OpenELIS-Global/* {
		reverse_proxy https://openelis-webapp:8443 {
			transport http {
				tls
				tls_trusted_ca_certs /etc/caddy/ca/openelis-ca.pem
				# The certificate is issued for the openelis.org names this
				# stack uses internally; the public hostname is Caddy's, not
				# the backend's.
				tls_server_name oe.openelis.org
			}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy openelis-frontend:80
	}
}

# ---------------------------------------------------------------------------
# id.<domain> — Keycloak.
#
# DH-008's OIDC/SAML flows need a stable public origin; browser cookies and
# redirect URIs are origin-bound, which is why SSO activation waits on this as
# well as on BLOCKER-5's authorization matrix.
# ---------------------------------------------------------------------------
id.{$BASE_DOMAIN} {
	import common
	reverse_proxy keycloak:8080 {
		# Keycloak builds absolute URLs (issuer, redirects) from these. Getting
		# them wrong produces tokens whose issuer does not match what the
		# browser reached, which fails only at login time.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}

# ---------------------------------------------------------------------------
# app.<domain> — the Daher clinical UI (UI-004, DECISIONS.md ADR-027).
#
# Same-origin by construction, not convenience: ADR-027 decided the browser
# holds OpenMRS's own session directly rather than a BFF minting one, which
# only works if the cookie OpenMRS sets on login lands on the same origin
# this app's own fetch() calls use. So this proxies OpenMRS's own API prefix
# (/openmrs/*) — not its SPA, which stays at emr. untouched — under this
# app's origin. This is safe because UI-003 measured that openmrs-gateway
# routes by path, not Host header: an arbitrary, unconfigured Host still
# reaches the real backend, so one backend instance legitimately answers for
# two origins without any upstream reconfiguration.
#
# OpenELIS is deliberately NOT mounted here. Its SAML ACS-URL derivation
# (fixed to lab.$BASE_DOMAIN vs. per-request like OpenMRS's OIDC) could not be
# confirmed live without enabling SAML on the running stack, which UI-004 was
# not permitted to do (see ADR-027's "open risk"). Until resolved,
# OpenELIS-touching actions stay native at lab.$BASE_DOMAIN.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# exchange.<domain> — DHealth Exchange API (DH-EX-008).
#
# Path-scoped to /exchange/v1/* on purpose, not a bare `reverse_proxy
# adapter:8000` for the whole vhost: the adapter also serves this stack's own
# health/readiness endpoints (app.py), which have never been meant to be
# public, and its OpenAPI docs are separately disabled at the FastAPI level
# (defense in depth, not the only control). Everything else 404s here rather
# than reaching the adapter at all, so a route added to the adapter later does
# not become public by omission.
#
# No UI at this hostname — DH-EX-008 explicitly excludes building one. Same
# auth model as DH-EX-002: fails closed 401 without a valid
# dhealth-exchange-realm bearer token (see exchange/identity_auth.py).
# ---------------------------------------------------------------------------
exchange.{$BASE_DOMAIN} {
	import common

	handle /exchange/v1/* {
		reverse_proxy adapter:8000
	}

	handle {
		respond 404
	}
}

app.{$BASE_DOMAIN} {
	import common

	# `route` (not the default directive ordering) so this CSRF check is
	# guaranteed to run before either handle block below, in the exact order
	# written — load-bearing here, unlike everywhere else in this file where
	# Caddy's default ordering was never something a mistake could hide in.
	route {
		# Defense-in-depth against the CSRF gap ADR-027 measured directly:
		# a cookie-authenticated POST /openmrs/patient with no CSRF token
		# reached real validation logic despite an org.owasp.csrfguard filter
		# already in OpenMRS's own chain — that filter does not cover this
		# path. A plain cross-site HTML form cannot set a custom header, and
		# neither OpenMRS nor its gateway emit any Access-Control-* headers
		# (verified directly against both — nothing here adds any either), so
		# a foreign script cannot set one via a CORS-preflighted fetch either.
		# This is defense-in-depth, not authorization — OpenMRS's own
		# privilege checks remain the real boundary; GET/HEAD are untouched.
		@openmrs_mutation_unprotected {
			path /openmrs/*
			method POST PUT PATCH DELETE
			not header X-Daher-App-Request 1
		}
		respond @openmrs_mutation_unprotected 403

		handle /openmrs/* {
			reverse_proxy openmrs-gateway:80 {
				# Hardens OpenMRS's own JSESSIONID (measured HttpOnly-only,
				# ADR-027) in transit, without touching emr.'s cookie or
				# OpenMRS's own Tomcat config. SameSite=Lax, not Strict: this
				# cookie must survive the top-level redirect back from
				# Keycloak a real OIDC login performs, and Lax — unlike
				# Strict — still sends a cookie on a cross-site top-level GET
				# navigation (exactly what following a redirect is) while
				# withholding it from a cross-site POST, the actual CSRF
				# vector. The rewrite mechanism itself is proven against this
				# route using the existing local-login session, which sets
				# the identical cookie; compatibility with a real SSO
				# handshake is reasoned from how SameSite is specified to
				# behave, not observed live — that needs BLOCKER-5.
				header_down Set-Cookie "HttpOnly" "HttpOnly; Secure; SameSite=Lax"
			}
		}

		# UI-011 (DH-008F, ADR-027): the browser holds a real OpenELIS session directly,
		# same as /openmrs/* above — no service account, no BFF, no identity translation.
		# UI-005 measured OpenELIS's own JSESSIONID as already Secure; HttpOnly;
		# SameSite=Strict, stricter than OpenMRS's, so unlike the block above there is no
		# cookie rewrite here: SameSite=Strict is not weakened merely to simplify a test,
		# and UI-005's own full round trip already worked with it in place. Mirrors lab.'s
		# existing TLS/trust-anchor handling below exactly, since it is the same upstream.
		handle /OpenELIS-Global/* {
			reverse_proxy https://openelis-webapp:8443 {
				transport http {
					tls
					tls_trusted_ca_certs /etc/caddy/ca/openelis-ca.pem
					tls_server_name oe.openelis.org
				}
				header_up X-Forwarded-Proto https
			}
		}

		handle {
			reverse_proxy daher-ui:80
		}
	}
}
