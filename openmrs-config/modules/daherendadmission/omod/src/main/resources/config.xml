<module configVersion="1.2">
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${MODULE_PACKAGE}</package>
	<author>Daher Health</author>
	<description>${project.parent.description}</description>

	<activator>${MODULE_PACKAGE}.DaherEndAdmissionActivator</activator>

	<require_version>${openmrs.platform.version}</require_version>

	<!-- Globally unique on purpose. See EndMaternityAdmissionServlet's own class javadoc for
	     why (UI-015D: a duplicate servlet-name across two modules broke Spring context refresh
	     for the entire instance, not just the colliding modules). -->
	<servlet>
		<servlet-name>daherEndMaternityAdmission</servlet-name>
		<servlet-class>${MODULE_PACKAGE}.web.EndMaternityAdmissionServlet</servlet-class>
	</servlet>
</module>
