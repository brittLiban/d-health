<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<bean id="daherEndAdmissionDao" class="org.openmrs.module.daherendadmission.db.DaherEndAdmissionDaoImpl">
		<property name="sessionFactory" ref="sessionFactory"/>
	</bean>

	<bean id="daherMaternityAdmissionServiceTarget"
	      class="org.openmrs.module.daherendadmission.DaherMaternityAdmissionServiceImpl">
		<property name="dao" ref="daherEndAdmissionDao"/>
	</bean>

	<!-- Wired identically to how core (patientService, visitService, etc.) and modules
	     (bedmanagement's bedManagementService) wire their own transactional services: the same
	     shared transactionManager, serviceInterceptors, and transactionAttributeSource beans
	     OpenMRS core already registers. This bean, called as the outermost entry point, is what
	     makes visitService.saveVisit()'s nested bedmanagement/queue calls join one shared
	     transaction instead of each opening an independent one. See ADR-030 (DECISIONS.md) and
	     BLOCKER-10's "UI-015D follow-up" (PROJECT_STATE.md) for the full proof. -->
	<bean id="daherMaternityAdmissionService"
	      class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="transactionManager" ref="transactionManager"/>
		<property name="target" ref="daherMaternityAdmissionServiceTarget"/>
		<property name="preInterceptors" ref="serviceInterceptors"/>
		<property name="transactionAttributeSource" ref="transactionAttributeSource"/>
	</bean>

	<bean id="daherTestOrderServiceTarget"
	      class="org.openmrs.module.daherendadmission.DaherTestOrderServiceImpl"/>

	<!-- Initializer imports the existing sys-admin role in its roles domain. This loader runs
	     immediately afterward and adds only the HTTP-configuration privilege. Module activator
	     callbacks are not dependency-ordered on OpenMRS 2.8.7, so this must not live there. -->
	<bean id="daherExternalConfigurationPrivilegeLoader"
	      class="org.openmrs.module.daherendadmission.DaherExternalConfigurationPrivilegeLoader"/>

	<!-- The same outer transaction/service-interceptor pattern as the admission operation. The
	     target retains the real request-thread user; it does not run as Daemon. -->
	<bean id="daherTestOrderService"
	      class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="transactionManager" ref="transactionManager"/>
		<property name="target" ref="daherTestOrderServiceTarget"/>
		<property name="preInterceptors" ref="serviceInterceptors"/>
		<property name="transactionAttributeSource" ref="transactionAttributeSource"/>
	</bean>

	<!-- Handler mappings discover MappedInterceptor beans from ancestor contexts. This point runs
	     after webservices.rest's Basic/session authentication filter but before any controller or
	     resource method can materialize configuration. It therefore cannot affect internal Java
	     AdministrationService calls used by patient search or native order numbering. -->
	<bean id="daherExternalConfigurationMappedInterceptor"
	      class="org.springframework.web.servlet.handler.MappedInterceptor">
		<constructor-arg>
			<list>
				<value>/rest/v1/systemsetting</value>
				<value>/rest/v1/systemsetting/**</value>
				<value>/rest/v1/localeandthemeconfiguration</value>
				<value>/rest/v1/localeandthemeconfiguration/**</value>
				<value>/rest/v1/visitconfiguration</value>
				<value>/rest/v1/visitconfiguration/**</value>
				<value>/rest/v1/nametemplate</value>
				<value>/rest/v1/nametemplate/**</value>
				<value>/rest/v1/addresstemplate</value>
				<value>/rest/v1/addresstemplate/**</value>
				<value>/rest/v1/systeminformation</value>
				<value>/rest/v1/systeminformation/**</value>
				<value>/module/webservices/rest/settings.form</value>
			</list>
		</constructor-arg>
		<constructor-arg>
			<bean class="org.openmrs.module.daherendadmission.web.DaherExternalConfigurationInterceptor"/>
		</constructor-arg>
	</bean>

</beans>
