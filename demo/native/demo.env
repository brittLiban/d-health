# DHealth Native Demo — env file (DH-DEMO-001)
#
# Deliberately committed, unlike the real `.env` (gitignored, holds live credentials): every
# value below is a fixed, documented, throwaway credential for a synthetic, local-only stack that
# never holds real patient data and is never reachable from outside this machine (Caddy binds
# 127.0.0.1-equivalent host ports only, same as the real stack). Reusing the real `.env`'s secrets
# here would be pointless risk for zero benefit -- this file exists so `scripts/demo/up.sh` needs
# nothing from the maternity/reference-connector stack's own configuration to run.
#
# Passed explicitly via `--env-file` by every scripts/demo/*.sh script -- never relies on
# Compose's own implicit `.env`-in-cwd discovery, so running the demo can never accidentally read
# (or collide with) the real stack's `.env` at the repo root.
#
# Kept intentionally short (all under the tracked-secret scan's 12-character threshold) so this
# file does not need excluding from that check on content grounds alone; its path is still listed
# in .github/workflows/ci.yml's exclusion list, mirroring the existing provisioning/demo/*
# precedent, because a throwaway demo credential is exactly the kind of fixture value that check
# already carves out.

BASE_DOMAIN=localhost

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=DemoKc1!
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=DemoKcDb1!
# Never actually exercised by this demo (the `daher` realm's OpenMRS/OpenELIS clients are not
# imported into any service this compose file runs) -- required only because Keycloak's
# `--import-realm` resolves every ${...} placeholder in every realm file it imports, including
# daher-realm.json, at startup.
KEYCLOAK_OPENMRS_CLIENT_SECRET=DemoOmrs1!
KEYCLOAK_ADAPTER_CLIENT_SECRET=DemoAdpt1!
KEYCLOAK_EXCHANGE_API_CLIENT_SECRET=DemoExAp1!

# DH-DEMO-001 "RESET SAFETY IS P0": deliberately NOT the real stack's own default
# (`adapter` -- see docker-compose.yml's `ADAPTER_DB_NAME:-adapter}`). `demo_seed.py`'s first
# safety check is that the database it just connected to is named exactly this -- a real
# deployment's adapter database is never named this, so a `demo_seed.py reset` accidentally
# pointed at a real connection string fails this check before touching anything.
ADAPTER_DB_NAME=dhealth_native_demo
ADAPTER_DB_USER=adapter
ADAPTER_DB_PASSWORD=DemoAdb1!

# DH-DEMO-001 "RESET SAFETY IS P0": the reset/seed script refuses to run at all unless this is
# set -- the demo compose file sets it on the adapter service; the real docker-compose.yml never
# does, and cannot by construction (it has no ADAPTER_DEMO_ENVIRONMENT key at all).
ADAPTER_DEMO_ENVIRONMENT=1

# Demo login credentials (DH-DEMO-001 "DEMO LOGIN EXPERIENCE") -- fixed, documented, non-secret by
# design. `scripts/demo/status.sh` prints these usernames; it never prints a password, matching
# every other status output in this repository.
DEMO_CLINICIAN_USERNAME=demo-clinician
DEMO_CLINICIAN_PASSWORD=DemoClin1!
DEMO_LAB_TECH_USERNAME=demo-lab-tech
DEMO_LAB_TECH_PASSWORD=DemoTech1!
DEMO_RELEASER_USERNAME=demo-releaser
DEMO_RELEASER_PASSWORD=DemoRel1!

# DHEALTH-NATIVE-ACCESS-001: two facility administrators, one per demo organization.
#
# Two rather than one, deliberately. A single administrator holding ORG_ADMIN in both demo
# organizations could not demonstrate the cross-organization boundary at all -- every attempt
# would legitimately succeed. `demo-admin` administers the clinic and `demo-lab-admin` the
# laboratory, so "Clinique A's administrator cannot touch Laboratoire B's staff" is a real
# question this baseline can ask.
#
# Neither carries any Keycloak realm role, exactly like the other three: ORG_ADMIN is an Exchange
# database fact (OrganizationMembership + OrganizationRoleAssignment), granted by `demo_seed.py`,
# never by anything stored in Keycloak. Neither is a platform administrator.
#
# Both passwords stay under the tracked-secret scan's 12-character threshold, like every value
# above, so this file needs no new content-based exclusion.
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=DemoAdm1!
DEMO_LAB_ADMIN_USERNAME=demo-lab-admin
DEMO_LAB_ADMIN_PASSWORD=DemoLbAd1!

# DHEALTH-BILLING-001/ADR-066: one cashier per demo organization.
#
# Each holds BILLING_CLERK and nothing else -- no clinical role, not an administrator. That is the
# whole point of the role existing: ADR-066 records that being an administrator, a clinician or a
# lab worker must not automatically make someone a cashier, and a baseline where the cashier were
# also the admin could not show it. It is also what makes the two directions testable: the cashier
# reaches no clinical screen, and the clinician reaches no till.
#
# BILLING_CLERK is an Exchange database fact (OrganizationMembership + OrganizationRoleAssignment)
# granted by `demo_seed.py`, never anything stored in Keycloak. Neither is a platform administrator.
#
# Both passwords stay under the tracked-secret scan's 12-character threshold, like every value
# above, so this file needs no new content-based exclusion.
DEMO_CLERK_USERNAME=demo-clerk
DEMO_CLERK_PASSWORD=DemoClk1!
DEMO_LAB_CLERK_USERNAME=demo-lab-clerk
DEMO_LAB_CLERK_PASSWORD=DemoLbCk1!

# `docker compose config`'s interpolation pass resolves every ${VAR:?} across the WHOLE base
# file `extends:` reads from (docker-compose.yml), not merely the handful of services this file
# actually runs -- confirmed empirically (2026-09-18): omitting any one of these fails config
# validation with an error naming an openmrs-db/openelis-* service this file never starts.
# Mirrors .github/workflows/ci.yml's own "compose interpolates and parses" job's identical
# dummy-value block for the identical reason: never used by any container this file actually
# runs, kept short for the same tracked-secret-scan reasoning as that job's own comment explains.
OMRS_DB_NAME=openmrs
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=demo-dummy
OMRS_DB_ROOT_PASSWORD=demo-dummy
OMRS_ADMIN_PASSWORD=DemoDum1
OE_DB_PASSWORD=demo-dummy
OE_DB_SUPERUSER_PASSWORD=demo-dummy
OE_POSTGRES_PASSWORD=demo-dummy
OE_ADMIN_PASSWORD=DemoDum1!
OE_KEYSTORE_PASSWORD=demo-dummy
OE_TRUSTSTORE_PASSWORD=demo-dummy

# ---------------------------------------------------------------------------
# DHEALTH-NATIVE-MVP-1.0 (2026-09-25): required because docker-compose.yml's
# `patient-notifier` service declares it with `:?`, and Compose interpolates every
# service in a file it is asked to `extends:` from -- including services this demo
# never starts. DH-NOTIFY-001 added that service after DH-DEMO-001 shipped, so
# `scripts/demo/up.sh` had been failing at interpolation since then, before a single
# container started. Found by trying to boot the demo for the browser qualification.
#
# The value is this demo's own public app origin. Nothing in the demo sends a patient
# message -- the notifier is not in the demo's service list, no provider credential
# exists, and WhatsApp stays BLOCKED (ADR-003 gate 5) -- but the variable must parse,
# and `https://` is a hard requirement of the adapter's own configuration check.
DHEALTH_PATIENT_PUBLIC_BASE_URL=https://app.localhost

# ---------------------------------------------------------------------------
# DHEALTH-NATIVE-MVP-1.0 (2026-09-25): without this, Keycloak falls back to
# docker-compose.yml's internal default (`http://keycloak.openelis.org:8080`) and builds
# every issuer, redirect and LOGIN FORM ACTION from it. The browser then posts the
# username and password to a hostname that exists only on the Docker network, gets
# ERR_NAME_NOT_RESOLVED, and lands on a blank page -- so **nobody has ever been able to
# sign in to this demo**. `scripts/qualify-native-auth.sh` sets this for its own ephemeral
# stack; the demo, written later, did not. Found by pointing a real browser at it.
#
# Must track BASE_DOMAIN above: it is the origin the browser actually reaches Keycloak on,
# through Caddy's own id.<domain> vhost (KC_PROXY_HEADERS=xforwarded does the rest).
KEYCLOAK_PUBLIC_URL=https://id.localhost

# ---------------------------------------------------------------------------
# DHEALTH-NATIVE-DEPLOY-001: the demo is now an overlay on docker-compose.native.yml, so it must
# satisfy that file's own contract too. The production topology gives PostgreSQL's superuser its
# own credential rather than reusing the adapter's -- three tenants, three passwords -- and this
# is the demo's synthetic value for it.
POSTGRES_SUPERUSER_PASSWORD=DemoPg1!

# ---------------------------------------------------------------------------
# DHEALTH-NATIVE-RECOVERY-001: patient notification, on the provider that contacts nothing.
#
# `fake` has no network code of any kind -- notify/fake.py's own docstring calls that the point,
# and names the native demo stack running the journey offline as the reason it exists. It creates
# REAL durable notification rows (enrollment, obligation, attempt) so recovery of them can be
# proven, while making a real WhatsApp message physically impossible from here.
#
# ADR-003's gate is unchanged by this line: WhatsApp stays BLOCKED, not DONE, until real
# credentials have run the flow. Nothing in this file is evidence about a real provider.
DHEALTH_NOTIFICATIONS_ENABLED=true
DHEALTH_NOTIFICATION_PROVIDER=fake
DHEALTH_NOTIFICATION_DEFAULT_REGION=DJ
