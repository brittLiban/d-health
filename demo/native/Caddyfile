# DHealth Native Demo — reverse proxy (DH-DEMO-001)
#
# Deliberately a separate, smaller file from `caddy/Caddyfile`, not a subset selected at runtime:
# this demo never boots `openmrs-gateway`/`openelis-frontend`/`openelis-webapp` at all (that is
# the entire point — the native demo must not wait on the maternity/reference-connector stack to
# become healthy), so `emr.<domain>`/`lab.<domain>` have nothing to proxy to here. Every vhost
# below that DOES exist (`id.`/`app.`/`exchange.`) is copied field-for-field from the real file's
# own routing decisions (ADR-027/ADR-050/DH-EX-008) — this is not a second, independently-reasoned
# routing design, only a narrower service list.
#
# ⚠️ Same `BASE_DOMAIN=localhost` caveat as the real file: Caddy's internal CA, not a public one.

{
	admin off
}

(common) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

# ---------------------------------------------------------------------------
# id.<domain> — Keycloak. Identical role to caddy/Caddyfile's own id. vhost.
# ---------------------------------------------------------------------------
id.{$BASE_DOMAIN} {
	import common
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}

# ---------------------------------------------------------------------------
# exchange.<domain> — DHealth Exchange API. Identical scoping to caddy/Caddyfile's own
# exchange. vhost (DH-EX-008): only /exchange/v1/* is reachable, everything else 404s.
# ---------------------------------------------------------------------------
exchange.{$BASE_DOMAIN} {
	import common

	handle /exchange/v1/* {
		reverse_proxy adapter:8000
	}

	handle {
		respond 404
	}
}

# ---------------------------------------------------------------------------
# app.<domain> — DHealth Clinic / DHealth Lab (same static build, same same-origin Exchange
# routing as caddy/Caddyfile's own app. vhost, DH-CLINIC-004A). No /openmrs/* or
# /OpenELIS-Global/* handling here -- this demo never runs either backend, so there is nothing
# for those paths to reach, and no CSRF-cookie-rewrite concern that only applies to them.
# ---------------------------------------------------------------------------
app.{$BASE_DOMAIN} {
	import common

	handle /exchange/v1/* {
		reverse_proxy adapter:8000
	}

	handle {
		reverse_proxy daher-ui:80
	}
}
