# =============================================================================
# Daher Health — environment configuration
#
#   cp .env.example .env   and fill in real values. NEVER commit .env.
#
# This file grows as each build step adds a service (docs/ARCHITECTURE.md §13).
# Variables are documented the moment they are introduced, not batched at the end.
#
# Currently covers: build steps 1 (OpenMRS), 3 (OpenELIS), 4 (Keycloak/SSO), DH-010 adapter,
# DH-014 backup, and DH-020 database hardening.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Timezone for every container and both databases. Djibouti is UTC+3.
# Do not leave this at UTC: clinical timestamps that differ by three hours
# between the EMR and the laboratory are a patient-safety problem, not cosmetic.
TZ=Africa/Djibouti


# -----------------------------------------------------------------------------
# Facility identity (DH-026 — multi-facility)
# -----------------------------------------------------------------------------

# Namespaces every container, volume and network for this facility, so two
# facilities can run on one host without colliding. Lowercase alphanumeric and
# hyphens only (a Compose restriction).
#
# ⚠️ STABLE FOR THE LIFE OF THE DEPLOYMENT. Compose derives volume names from
# this. Changing it does not rename anything — it points the stack at a fresh set
# of empty volumes and orphans the old ones. On a clinical stack that means
# orphaning the patient database while everything still appears to start
# normally. Set it once, before the first `up`, and never edit it afterwards.
#
# It is an identity, not a display name. The human-readable facility name lives
# in the provisioning record, not here.
FACILITY_ID=default


# -----------------------------------------------------------------------------
# OpenMRS database (MariaDB)
#
# Generate passwords, do not invent them by hand:
#   openssl rand -base64 30
# -----------------------------------------------------------------------------

OMRS_DB_NAME=openmrs
OMRS_DB_USER=openmrs

# CHANGE ME — application user password.
OMRS_DB_PASSWORD=

# CHANGE ME — MariaDB root password. Different from the above.
OMRS_DB_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# OpenMRS application
# -----------------------------------------------------------------------------

# Default locale for the O3 single-page application. French is the working
# medical and administrative language in Djibouti; this is deliberate, not a
# placeholder. The backend's allowed-locale list is configured separately in
# openmrs-config/ (build step 2).
OMRS_DEFAULT_LOCALE=fr

# Load OpenMRS demo patients on first boot.
#
# ⚠️ VERIFIED INERT at build step 1 (DH-002): the O3 backend image's startup
# scripts do not read OMRS_CONFIG_ADD_DEMO_DATA, so setting this to `true`
# is not known to do anything. Kept, pinned to false, so nobody re-adds it
# believing it works.
#
# Demo data means fictional people in the same tables as real ones. The working,
# verified control is `OMRS_DEMO_PATIENTS` in the Demo data section below. This
# inert variable remains pinned to false so nobody mistakes it for that control.
OMRS_ADD_DEMO_DATA=false


# -----------------------------------------------------------------------------
# OpenMRS admin account
# -----------------------------------------------------------------------------

# ⚠️ FIRST-BOOT ONLY, and REQUIRED — `up` fails without it (DH-019).
#
# This password is written into the database when OpenMRS initialises an empty
# schema. Setting it against an already-initialised volume does nothing: the
# account exists, and recovery becomes a manual password change inside OpenMRS.
# On any instance that is not a throwaway, set it BEFORE the very first
# `docker compose up -d`. There is no second chance at it.
#
# Unset, the image would default to the published value `Admin123`, so the
# compose file guards this with `${OMRS_ADMIN_PASSWORD:?}` — a missing value
# fails loudly at startup rather than silently shipping a known admin password.
#
# Generate it, do not invent it:
#   openssl rand -base64 30
#
# NOTE: OpenMRS enforces password complexity (upper, lower, digit, and not
# containing the username). If a generated value is refused at first boot,
# regenerate rather than hand-editing down to something weaker.
OMRS_ADMIN_PASSWORD=

# Local-only port for verifying OpenMRS before the reverse proxy exists
# (build step 8). Binds to 127.0.0.1, never to a public interface.
# On a remote VM, reach it with an SSH tunnel — see README.
OMRS_LOCAL_PORT=8080

# Maternity ward bed counts. These are MARKED PLACEHOLDERS (2/4, decided
# 2026-08-14), not the birth centre's real numbers.
#
# ⚠️ The seed is ADDITIVE-ONLY (ADR-007), so these beds CANNOT be removed by
# lowering the number later. On restart it adds missing beds up to these counts;
# lowering a value NEVER removes, retires, moves, or edits a bed. If the real
# delivery count turns out to be 1, that second bed is permanent.
#
# Raising is free, lowering does nothing. Set the real facility numbers BEFORE
# the pilot deployment, not after.
MATERNITY_DELIVERY_BEDS=2
MATERNITY_POSTPARTUM_BEDS=4


# -----------------------------------------------------------------------------
# OpenELIS + PostgreSQL (build step 3, DH-005)
#
# One PostgreSQL instance hosts three databases: OpenELIS's own `clinlims`, plus
# Keycloak and the adapter as co-tenants (ADR-001). Each has its own role and no
# rights in the others — co-tenancy is a deployment convenience, not a relaxed
# trust boundary.
#
# ⚠️ These are consumed by /docker-entrypoint-initdb.d, which PostgreSQL runs
# ONCE, on an empty data directory. Set them before the first `up`; changing them
# afterwards does not re-provision anything.
#
#   openssl rand -base64 30
# -----------------------------------------------------------------------------

# OpenELIS application DB user (`clinlims`). The image defaults this to the
# literal `clinlims` when unset, so it is guarded in compose.
OE_DB_PASSWORD=

# OpenELIS's `admin` superuser role. Image default when unset is `superuser`.
OE_DB_SUPERUSER_PASSWORD=

# The initdb bootstrap superuser (`postgres`) — a THIRD, separate credential from
# the two above. Without it the image crash-loops with "Database is uninitialized
# and superuser password is not specified" (observed at DH-005).
OE_POSTGRES_PASSWORD=

# OpenELIS admin account. Upstream ships the published `adminADMIN!` hash and
# ignores its documented DEFAULT_PW environment variable. DH-024's one-shot
# waits for first webapp bootstrap, replaces exactly that admin row with this
# value, verifies the bcrypt hash, and only then allows the frontend to start.
# This value is authoritative on each `docker compose up -d`.
#
# OpenELIS accepts only letters, numbers, and these special characters: * $ # !
# It requires at least seven characters and at least one listed special. The
# narrower generated example below avoids producing a secret the app rejects:
#   printf 'Dh%s!\n' "$(openssl rand -hex 20)"
OE_ADMIN_PASSWORD=

# Internal keystore/truststore passwords.
#
# These protect the keystore behind the internal 8443 connectors. They are NOT
# the public TLS certificate — Caddy handles that at DH-016.
#
# ✅ DH-021 RESOLVED 2026-08-13. The keystore is no longer upstream's — it is
# generated on this deployment by the local `openelis-certs` image, so the
# private key exists only here. It replaced material that was BOTH publicly
# downloadable AND already expired (notAfter 2026-07-23), which nothing on the
# internal path was validating.
#
# ⚠️ BOTH ARE REQUIRED. Compose uses `:?` and refuses to start if either is
# empty. That is deliberate: the old `${OE_KEYSTORE_PASSWORD:-kspass}` fallback
# meant an empty value silently selected upstream's PUBLISHED password while the
# variable looked configured — which is how this deployment ended up running on
# `kspass`/`tspass`. Never set these to `kspass` or `tspass`.
#
#   openssl rand -base64 32
#
# These are consumed in two places that MUST agree: the keystore itself, and the
# rendered common.properties (OpenELIS reads its SSL password from that file,
# not from CATALINA_OPTS). One job produces both, so they cannot drift. Changing
# a value regenerates the keystore on the next `up` and requires recreating
# openelis-webapp and openelis-fhir to reload it.
OE_KEYSTORE_PASSWORD=
OE_TRUSTSTORE_PASSWORD=

# DH-011D3 (§12): the real facility OpenELIS numeric site code (SITEYEARNUM accession
# format). NEEDS LIBAN #7 -- leave this blank. Blank is not a placeholder; it is the
# only value this repository is permitted to invent, and LiquibaseConfig refuses to
# start if it is ever set to the upstream placeholder `DEV01` or a non-numeric value.
# Supplying the real value here and running `docker compose up -d openelis-webapp` is
# the one reproducible path (see openelis-config/patches/order-correlation/
# 002-site-code-configuration.xml) -- never set it by hand in the admin UI or by
# manual SQL against a deployment meant to stay reproducible.
DAHER_OPENELIS_SITE_CODE=

# Certificate lifetime, and how early to renew. Renewal is early by design: the
# material this replaced expired silently and kept serving for three weeks.
OE_CERT_VALIDITY_DAYS=825
OE_CERT_RENEW_BEFORE_DAYS=30

# Keycloak database (co-tenant). Created at DH-005 because initdb.d only runs
# once; consumed by the Keycloak service added at DH-007.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Keycloak identity provider and fail-closed SSO plumbing (build step 4, DH-007/DH-008)
#
# A fresh realm imports from keycloak/realm-config/; an existing realm is
# reconciled by the non-deleting keycloak-sso-config job. Activation and the
# one-login proof remain blocked on the native authorization matrix.
# -----------------------------------------------------------------------------

# Public DNS suffix used to build SSO redirect URIs. Caddy and public DNS arrive
# at DH-016; `localhost` is correct only for local verification.
BASE_DOMAIN=localhost
# Host ports Caddy publishes. 80/443 on the pilot VM; overridden locally so this
# workstation's existing services are not displaced.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Only meaningful once BASE_DOMAIN is a real, publicly resolvable domain. Left
# EMPTY here on purpose and NOT referenced in the Caddyfile: Caddy fails to
# parse the whole file if `email` is present with an empty value, which takes
# the proxy down rather than degrading. Add the directive with a real address
# when the domain arrives.
CADDY_ACME_EMAIL=

# Browser-visible Keycloak origin. Before Caddy, the internal default below is
# usable by the automated Docker-network verification client. At DH-016 this
# must become https://id.<BASE_DOMAIN> so staff browsers can reach it.
KEYCLOAK_PUBLIC_URL=http://keycloak.openelis.org:8080

# Optional explicit public application origins. Their defaults are derived from
# BASE_DOMAIN. Set them only when the reverse-proxy hostnames differ.
# OPENMRS_PUBLIC_URL=https://emr.example.org
# OPENELIS_PUBLIC_URL=https://lab.example.org
# DAHER_APP_PUBLIC_URL=https://app.example.org

# Keep false until the DH-008 application-role/provider mapping has Liban's
# approval. False unloads the OpenMRS OAuth module and leaves OpenELIS SAML off;
# both local break-glass logins continue to work.
SSO_ENABLED=false

# Bootstrap administrator. The password is used to create the first Keycloak
# administrator against an empty Keycloak database. Once that administrator
# exists, changing this value does not rotate its password.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC client secrets for OpenMRS and the adapter service account. OpenELIS uses
# SAML and has no client secret. Generate two different values. They are
# substituted into the realm import at first boot; no literal client secret is
# committed to the repository.
KEYCLOAK_OPENMRS_CLIENT_SECRET=
KEYCLOAK_ADAPTER_CLIENT_SECRET=

# Adapter database (co-tenant). Holds the processed-message ledger and the
# dead-letter table (DH-010).
ADAPTER_DB_NAME=adapter
ADAPTER_DB_USER=adapter
ADAPTER_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Adapter safety skeleton (DH-010)
# -----------------------------------------------------------------------------

# Retry only applies to explicitly transient integration failures. Validation
# failures and malformed FHIR resources fail immediately and enter operator
# handling; retrying bad clinical data five times does not make it valid.
ADAPTER_RETRY_MAX_ATTEMPTS=5
ADAPTER_RETRY_MULTIPLIER_SECONDS=1
ADAPTER_RETRY_MAX_SECONDS=30

# The accepted 15-second OpenMRS order interval (ADR-005) is added to the
# environment when the poller itself lands at DH-011. There is deliberately no
# inert variable here that looks implemented before code consumes it.


# -----------------------------------------------------------------------------
# Demo data (BLOCKER-2)
# -----------------------------------------------------------------------------

# Whether this instance is seeded with 50 FICTIONAL DEMO PATIENTS on first boot.
#
#   off  — no demo patients. The default, and the only correct value for any
#          instance that will hold real patient records.
#   on   — 50 fictional people (Betty Williams, Michael Turner, …) in the same
#          `patient` table as real ones. For training or demo instances only.
#
# ⚠️ Normally chosen before first boot. The distro's module zeroes its control
# property after firing, and Initializer does not reload an unchanged file.
# Changing this file-selection from `off` to `on` on an existing database does
# change the checksum and can inject 50 fictional patients. That would be a
# serious mistake on any database holding real records.
#
# NOTE: `OMRS_ADD_DEMO_DATA` above is a different thing and is inert — it was
# verified to do nothing in this image. This is the switch that actually works.
#
# This does NOT control the distro's demo *concept* content (lab tests,
# diagnoses, drugs). That is a separate knob by design, because turning it off
# may remove the vocabulary the prenatal panel needs — see DH-003.
# `on` requires a completed `OMRS_DEMO_CONTENT=off`, patients-off boot first,
# because the upstream task runs before its `OpenMRS ID` metadata is initialized.
# The database preflight refuses first-boot on/on, and the backend refuses
# content-off/on, rather than silently resetting the trigger with zero patients.
OMRS_DEMO_PATIENTS=off

# Load the O3 distribution's referenceapplication-demo concepts and metadata.
#
#   on  — upstream content as shipped (default). This includes BasicLabTests and
#         other reference vocabulary that later mapping work may need.
#   off — select a local image target that omits the pinned distro's
#         referenceapplication-demo source. Existing DB content is not removed.
#
# This is independent of OMRS_DEMO_PATIENTS. Do not treat `off` as a clinically
# approved concept dictionary; all clinical content still needs clinical sign-off.
OMRS_DEMO_CONTENT=off


# -----------------------------------------------------------------------------
# Encrypted nightly backup (DH-014; performed restore is separately DH-015)
# -----------------------------------------------------------------------------

# Leave empty while backup credentials/destination are intentionally absent.
# After those settings are approved and filled, set this to `backup`; the normal
# one-command `docker compose up -d` will then include the scheduler.
COMPOSE_PROFILES=

# REQUIRED. Used before any archive can leave the backup staging directory.
# Store this outside the VM as well: a backup whose only key died with the VM is
# not recoverable. Changing it does not re-encrypt older archives.
BACKUP_ENCRYPTION_PASSPHRASE=

# UTC hour 0-23 and local encrypted-archive retention.
BACKUP_HOUR_UTC=0
BACKUP_RETENTION_DAYS=30

# Production/pilot default: absence or failure of off-site upload makes the run
# FAILED even when an encrypted local archive exists. Set false only for an
# explicit local verification run; that is not pilot-ready backup coverage.
BACKUP_REQUIRE_OFFSITE=true

# S3-compatible destination. Supplying these changes where encrypted patient
# backups leave the system and therefore requires Liban's explicit approval.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
