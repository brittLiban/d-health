# =============================================================================
# Daher Health — environment configuration
#
#   cp .env.example .env   and fill in real values. NEVER commit .env.
#
# This file grows as each build step adds a service (docs/ARCHITECTURE.md §13).
# Variables are documented the moment they are introduced, not batched at the end.
#
# Currently covers: build steps 1 (OpenMRS), 3 (OpenELIS), 4a (Keycloak), and DH-014 backup.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Timezone for every container and both databases. Djibouti is UTC+3.
# Do not leave this at UTC: clinical timestamps that differ by three hours
# between the EMR and the laboratory are a patient-safety problem, not cosmetic.
TZ=Africa/Djibouti


# -----------------------------------------------------------------------------
# OpenMRS database (MariaDB)
#
# Generate passwords, do not invent them by hand:
#   openssl rand -base64 30
# -----------------------------------------------------------------------------

OMRS_DB_NAME=openmrs
OMRS_DB_USER=openmrs

# CHANGE ME — application user password.
OMRS_DB_PASSWORD=

# CHANGE ME — MariaDB root password. Different from the above.
OMRS_DB_ROOT_PASSWORD=


# -----------------------------------------------------------------------------
# OpenMRS application
# -----------------------------------------------------------------------------

# Default locale for the O3 single-page application. French is the working
# medical and administrative language in Djibouti; this is deliberate, not a
# placeholder. The backend's allowed-locale list is configured separately in
# openmrs-config/ (build step 2).
OMRS_DEFAULT_LOCALE=fr

# Load OpenMRS demo patients on first boot.
#
# ⚠️ VERIFIED INERT at build step 1 (DH-002): the O3 backend image's startup
# scripts do not read OMRS_CONFIG_ADD_DEMO_DATA, so setting this to `true`
# is not known to do anything. Kept, pinned to false, so nobody re-adds it
# believing it works.
#
# Demo data means fictional people in the same tables as real ones. If demo
# patients are ever wanted, find the mechanism this image actually supports and
# verify it — do not assume this variable did it.
OMRS_ADD_DEMO_DATA=false


# -----------------------------------------------------------------------------
# OpenMRS admin account
# -----------------------------------------------------------------------------

# ⚠️ FIRST-BOOT ONLY, and REQUIRED — `up` fails without it (DH-019).
#
# This password is written into the database when OpenMRS initialises an empty
# schema. Setting it against an already-initialised volume does nothing: the
# account exists, and recovery becomes a manual password change inside OpenMRS.
# On any instance that is not a throwaway, set it BEFORE the very first
# `docker compose up -d`. There is no second chance at it.
#
# Unset, the image would default to the published value `Admin123`, so the
# compose file guards this with `${OMRS_ADMIN_PASSWORD:?}` — a missing value
# fails loudly at startup rather than silently shipping a known admin password.
#
# Generate it, do not invent it:
#   openssl rand -base64 30
#
# NOTE: OpenMRS enforces password complexity (upper, lower, digit, and not
# containing the username). If a generated value is refused at first boot,
# regenerate rather than hand-editing down to something weaker.
OMRS_ADMIN_PASSWORD=

# Local-only port for verifying OpenMRS before the reverse proxy exists
# (build step 8). Binds to 127.0.0.1, never to a public interface.
# On a remote VM, reach it with an SSH tunnel — see README.
OMRS_LOCAL_PORT=8080


# -----------------------------------------------------------------------------
# OpenELIS + PostgreSQL (build step 3, DH-005)
#
# One PostgreSQL instance hosts three databases: OpenELIS's own `clinlims`, plus
# Keycloak and the adapter as co-tenants (ADR-001). Each has its own role and no
# rights in the others — co-tenancy is a deployment convenience, not a relaxed
# trust boundary.
#
# ⚠️ These are consumed by /docker-entrypoint-initdb.d, which PostgreSQL runs
# ONCE, on an empty data directory. Set them before the first `up`; changing them
# afterwards does not re-provision anything.
#
#   openssl rand -base64 30
# -----------------------------------------------------------------------------

# OpenELIS application DB user (`clinlims`). The image defaults this to the
# literal `clinlims` when unset, so it is guarded in compose.
OE_DB_PASSWORD=

# OpenELIS's `admin` superuser role. Image default when unset is `superuser`.
OE_DB_SUPERUSER_PASSWORD=

# The initdb bootstrap superuser (`postgres`) — a THIRD, separate credential from
# the two above. Without it the image crash-loops with "Database is uninitialized
# and superuser password is not specified" (observed at DH-005).
OE_POSTGRES_PASSWORD=

# OpenELIS admin account. Upstream's compose ships DEFAULT_PW=adminADMIN! — the
# same published-default hazard as the OpenMRS admin password (DH-019).
# NOT VERIFIED whether this is first-boot-only; assume it is and set it now.
OE_ADMIN_PASSWORD=

# Internal keystore/truststore passwords.
#
# ⚠️ LEAVE THESE EMPTY unless DH-021 has landed. Verified at DH-005: the certgen
# image does not generate anything — it ships pre-built keystores whose passwords
# are fixed at `kspass` / `tspass`. Setting these to your own value does not
# re-key anything; it just stops Tomcat opening the keystore, and the webapp then
# fails to start with "Error creating SSLContext".
#
# These protect a keystore used only for an internal-network connector. They are
# NOT the public TLS certificate — Caddy handles that at DH-016.
#
# ⚠️ SECURITY, tracked as DH-021: because the keystore ships inside a public
# image, its private key is public. Anyone can download it. Acceptable only while
# nothing outside the Docker network speaks to port 8443.
OE_KEYSTORE_PASSWORD=
OE_TRUSTSTORE_PASSWORD=

# Keycloak database (co-tenant). Created at DH-005 because initdb.d only runs
# once; consumed by the Keycloak service added at DH-007.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Keycloak identity provider (build step 4a, DH-007)
#
# The realm, roles and clients are imported from keycloak/realm-config/. SSO
# wiring into OpenMRS and OpenELIS is deliberately separate (DH-008).
# -----------------------------------------------------------------------------

# Public DNS suffix used to build OIDC redirect URIs. Caddy and public DNS arrive
# at DH-016; `localhost` is correct only for local verification.
BASE_DOMAIN=localhost

# Bootstrap administrator. The password is used to create the first Keycloak
# administrator against an empty Keycloak database. Once that administrator
# exists, changing this value does not rotate its password.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC client secrets for the two applications and the adapter service account.
# Generate three different values. They are substituted into the realm import
# at first boot; no literal client secret is committed to the repository.
KEYCLOAK_OPENMRS_CLIENT_SECRET=
KEYCLOAK_OPENELIS_CLIENT_SECRET=
KEYCLOAK_ADAPTER_CLIENT_SECRET=

# Adapter database (co-tenant). Holds the processed-message ledger and the
# dead-letter table (DH-010).
ADAPTER_DB_NAME=adapter
ADAPTER_DB_USER=adapter
ADAPTER_DB_PASSWORD=


# -----------------------------------------------------------------------------
# Demo data (BLOCKER-2)
# -----------------------------------------------------------------------------

# Whether this instance is seeded with 50 FICTIONAL DEMO PATIENTS on first boot.
#
#   off  — no demo patients. The default, and the only correct value for any
#          instance that will hold real patient records.
#   on   — 50 fictional people (Betty Williams, Michael Turner, …) in the same
#          `patient` table as real ones. For training or demo instances only.
#
# ⚠️ TAKES EFFECT ON FIRST BOOT ONLY. The distro's module zeroes its own control
# property once it has fired, so this is read against an empty schema and never
# again. Setting it on an existing deployment does nothing — and setting it to
# `on` against a database that already holds real patients would be a serious
# mistake, not a no-op.
#
# NOTE: `OMRS_ADD_DEMO_DATA` above is a different thing and is inert — it was
# verified to do nothing in this image. This is the switch that actually works.
#
# This does NOT control the distro's demo *concept* content (lab tests,
# diagnoses, drugs). That is a separate knob by design, because turning it off
# may remove the vocabulary the prenatal panel needs — see DH-003.
OMRS_DEMO_PATIENTS=off


# -----------------------------------------------------------------------------
# Encrypted nightly backup (DH-014; performed restore is separately DH-015)
# -----------------------------------------------------------------------------

# REQUIRED. Used before any archive can leave the backup staging directory.
# Store this outside the VM as well: a backup whose only key died with the VM is
# not recoverable. Changing it does not re-encrypt older archives.
BACKUP_ENCRYPTION_PASSPHRASE=

# UTC hour 0-23 and local encrypted-archive retention.
BACKUP_HOUR_UTC=0
BACKUP_RETENTION_DAYS=30

# Production/pilot default: absence or failure of off-site upload makes the run
# FAILED even when an encrypted local archive exists. Set false only for an
# explicit local verification run; that is not pilot-ready backup coverage.
BACKUP_REQUIRE_OFFSITE=true

# S3-compatible destination. Supplying these changes where encrypted patient
# backups leave the system and therefore requires Liban's explicit approval.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
