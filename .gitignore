# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
keycloak/realm-config/*-secrets.json
backup/*.sql
backup/*.sql.gz
backup/*.dump

# ---- Runtime data ----
data/
volumes/
caddy/data/
caddy/config/

# ---- DH-CLINIC-004B qualification output (scripts/qualify-native-auth.sh) ----
qualification-evidence-*.json

# ---- Python build/test artifacts (repo-wide: adapter/, provisioning/,
# openmrs-config/seed/, openmrs-config/forms/, any future Python subtree) ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# ---- Adapter ----
adapter/node_modules/

# ---- Node (repo-wide catch-all; ui/ and any future Node subtree carry their
# own more specific .gitignore too) ----
node_modules/

# ---- OpenMRS module builds (Maven; root-owned when built via the pinned Docker toolchain) ----
openmrs-config/modules/*/target/
openmrs-config/modules/*/*/target/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp

# DHEALTH-NATIVE-MVP-1.0: the browser golden-journey report, written at the repository root by
# scripts/demo/qualify-journey.sh. Evidence of a run, not part of the source.
native-journey-results.json
