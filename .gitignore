# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
keycloak/realm-config/*-secrets.json
backup/*.sql
backup/*.sql.gz
backup/*.dump

# ---- Runtime data ----
data/
volumes/
caddy/data/
caddy/config/

# ---- Python build/test artifacts (repo-wide: adapter/, provisioning/,
# openmrs-config/seed/, openmrs-config/forms/, any future Python subtree) ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# ---- Adapter ----
adapter/node_modules/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp
