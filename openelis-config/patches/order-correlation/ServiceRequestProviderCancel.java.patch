+    /**
+     * DH-011J: cancel one added-test event, resolved by the Daher correlation the adapter
+     * actually holds -- not {@code deleteServiceRequest}'s {@code fhirUuid}, which DH-025 never
+     * learns or stores. A custom FHIR operation rather than an overload of {@code @Delete}
+     * because HAPI's {@code @Delete} only supports instance delete by {@code @IdParam}, and
+     * rather than {@code @Update}/PUT because that surface is permanently CI-guarded shut (see
+     * PROVENANCE.md's DH-011P2 §15 finding) -- this method never issues or enables a PUT.
+     *
+     * <p>Deliberately out of scope, per DH-011J §7: cancelling an entire initial order. This
+     * operation only resolves targets through {@code daher_analysis_correlation} -- the
+     * added-test namespace -- so an initial-order correlation (which lives in
+     * {@code electronic_order}, a different table this method never queries) simply will not
+     * resolve, returning {@code not-found} rather than doing anything to the initial order's own
+     * Analysis. That is a deliberate scope boundary, not an oversight: see PROVENANCE.md and
+     * PROJECT_STATE.md for why whole-initial-order cancellation remains Human Decision Required.
+     *
+     * <p>Returns a {@code Parameters} resource carrying the authoritative post-call outcome and
+     * status -- never a bare 200/204 that would let the caller guess what happened. Idempotent by
+     * design: a target already {@code Canceled} returns {@code ALREADY_CANCELLED} without a
+     * second mutation (§16); a target in any other native status is refused, not silently
+     * overwritten (§14, ADR-018).
+     */
+    @Operation(name = "$cancel", idempotent = false)
+    public Parameters cancelServiceRequest(@OperationParam(name = "correlation") String correlationValue,
+            HttpServletRequest request) {
+        final String method = "cancelServiceRequest";
+
+        try {
+            if (correlationValue == null || correlationValue.isBlank()) {
+                throw new InvalidRequestException("Missing required 'correlation' operation parameter");
+            }
+
+            String sysUserId = FhirProviderUtils.getSysUserId(request);
+
+            org.openelisglobal.dataexchange.fhir.DaherCancellationTransaction.Result result = daherCancellationTransaction
+                    .cancelByCorrelation(correlationValue, sysUserId);
+
+            if (result.getOutcome() == org.openelisglobal.dataexchange.fhir.DaherCancellationTransaction.Outcome.NOT_FOUND) {
+                throw new ResourceNotFoundException(
