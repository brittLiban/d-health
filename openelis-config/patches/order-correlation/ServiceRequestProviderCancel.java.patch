+            }
+
+            if (result.getOutcome() == org.openelisglobal.dataexchange.fhir.DaherCancellationTransaction.Outcome.CANCELLED) {
+                try {
+                    fhirTransformService.transformAnalysisByIds(List.of(String.valueOf(result.getAnalysisId())));
+                } catch (Exception fhirEx) {
+                    LogEvent.logWarn(this.getClass().getSimpleName(), method,
+                            "FHIR sync failed after cancel (non-blocking): " + safeMessage(fhirEx));
+                }
+            }
+
+            Parameters response = new Parameters();
+            response.addParameter().setName("outcome").setValue(new StringType(result.getOutcome().name()));
+            response.addParameter().setName("analysisId")
