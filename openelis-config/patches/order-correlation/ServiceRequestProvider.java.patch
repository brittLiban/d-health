+    /**
+     * DH-011D: extracts the exactly-one Daher order-correlation identifier from an inbound
+     * ServiceRequest. Fails closed -- an order DH-025 cannot deterministically reconcile must
+     * never be silently accepted. System and value comparisons are both exact: no case
+     * folding, no substring, no fuzzy matching. Identifiers on other systems (accession,
+     * requisition, or anything else a caller attaches) are ignored entirely and never
+     * mistaken for this one.
+     */
+    private String extractDaherOrderIdentifier(ServiceRequest serviceRequest) {
+        List<Identifier> matches = new ArrayList<>();
+        if (serviceRequest.hasIdentifier()) {
+            for (Identifier identifier : serviceRequest.getIdentifier()) {
+                if (identifier != null && DaherOrderCorrelation.SYSTEM.equals(identifier.getSystem())) {
+                    matches.add(identifier);
+                }
+            }
+        }
+        if (matches.isEmpty()) {
+            throw new InvalidRequestException("ServiceRequest.identifier must carry exactly one "
+                    + DaherOrderCorrelation.SYSTEM + " identifier; found none");
+        }
+        if (matches.size() > 1) {
+            throw new InvalidRequestException("ServiceRequest.identifier must carry exactly one "
+                    + DaherOrderCorrelation.SYSTEM + " identifier; found " + matches.size());
+        }
+        String value = matches.get(0).getValue();
+        if (GenericValidator.isBlankOrNull(value)
+                || !DaherOrderCorrelation.VALUE_PATTERN.matcher(value).matches()) {
+            throw new InvalidRequestException("The " + DaherOrderCorrelation.SYSTEM
+                    + " identifier value is malformed -- expected a 64-character lowercase hex digest");
+        }
+        return value;
+    }
+
+    /**
