+    /**
+     * DH-011D3: the authoritative native lookup Finding B requires. Never touches the
+     * secondary HAPI store. Zero matches on a genuinely absent correlation, exactly one
+     * FHIR-typed {@code electronic_order} row per the partial unique index this patch's
+     * migration adds -- an internal inconsistency (a correlation row with no linked sample, or
+     * more than one Sample linked to the same correlation, either of which the outer
+     * transaction in {@code createServiceRequest} should make impossible in committed state)
+     * fails loudly rather than silently reporting zero or fabricating a count.
+     *
+     * <p><b>{@code Bundle.total} counts logical orders (0 or 1 -- the partial unique index
+     * guarantees at most one), not constituent {@code ServiceRequest} resources.</b> One order
+     * commonly carries more than one test (a prenatal panel, for example), which produces one
+     * {@code Analysis} per test and therefore one {@code ServiceRequest} bundle entry per test.
+     * DH-025's probe treats exactly-one-native-match as success; if {@code total} counted
+     * entries instead, every multi-test order would read back as ambiguous and the ledger could
+     * never complete -- the opposite of what a correlation search this deep exists to prove.
+     * Every constituent {@code ServiceRequest} is still returned as a Bundle entry for callers
+     * that want them; only the count DH-025 keys off is collapsed to the logical-order level.
+     */
+    private Bundle searchDaherCorrelationNatively(String correlationValue) {
+        List<ElectronicOrder> candidates = electronicOrderService.getElectronicOrdersByExternalId(correlationValue);
+        List<ElectronicOrder> fhirOrders = candidates.stream()
+                .filter(o -> o != null && ElectronicOrderType.FHIR.equals(o.getType()))
+                .collect(Collectors.toList());
+        if (fhirOrders.size() > 1) {
+            // The partial unique index (electronic_order(external_id) WHERE type='FHIR') makes
+            // this structurally impossible in committed state. If it is ever observed, trust
+            // the database over the assumption and fail loudly rather than silently picking one
+            // -- exactly the "never fabricate a result" discipline this whole method enforces.
+            throw new InternalErrorException(
+                    "Data integrity violation: multiple FHIR-typed electronic_order rows share "
+                            + "external_id " + correlationValue + " -- the uniqueness index should "
+                            + "make this impossible");
+        }
+
+        List<org.openelisglobal.dataexchange.fhir.DaherAnalysisCorrelation> addedTestMatches = daherAnalysisCorrelationService
+                .getByCorrelationValue(correlationValue);
+        if (addedTestMatches.size() > 1) {
+            // UNIQUE(correlation_value) should make this structurally impossible in committed
+            // state -- same "trust the database over the assumption" discipline as every other
+            // fail-loud check in this method.
+            throw new InternalErrorException("Data integrity violation: multiple daher_analysis_correlation "
+                    + "rows share correlation_value " + correlationValue);
+        }
+
+        boolean initialOrderNamespaceMatch = !fhirOrders.isEmpty();
+        boolean addedTestNamespaceMatch = !addedTestMatches.isEmpty();
+
+        if (initialOrderNamespaceMatch && addedTestNamespaceMatch) {
+            // DH-011P Section 9, rule D: the same correlation value exists in both namespaces.
+            // These are two structurally independent tables with no shared uniqueness
+            // constraint between them, so nothing at the database level prevents this -- it can
+            // only be a corrupted/colliding input, never a legitimate state. Never resolve by
+            // priority ("initial order wins"): fail closed and let an operator investigate.
+            throw new InternalErrorException("Data integrity violation: correlation " + correlationValue
+                    + " matches both the initial-order namespace (electronic_order.external_id) and the "
+                    + "added-test namespace (daher_analysis_correlation.correlation_value) -- refusing to "
+                    + "silently pick one");
+        }
+
+        if (addedTestNamespaceMatch) {
+            return searchAddedTestNamespace(addedTestMatches.get(0), correlationValue);
+        }
+
+        Bundle bundle = new Bundle();
+        bundle.setType(Bundle.BundleType.SEARCHSET);
+        bundle.setEntry(new ArrayList<>());
+
+        if (fhirOrders.isEmpty()) {
+            bundle.setTotal(0);
+            return bundle;
+        }
+
+        ElectronicOrder order = fhirOrders.get(0);
+        List<Sample> linkedSamples = sampleService.getAllMatching("clinicalOrderId", order.getId());
+        if (linkedSamples == null || linkedSamples.isEmpty()) {
+            // A correlation exists but nothing is linked to it. With Finding A's outer
+            // transaction in place, this should not be reachable in committed state --
+            // treat it the same as the size>1 case above: a real inconsistency, not a
+            // reason to report zero and let DH-025 retry into it.
+            throw new InternalErrorException(
+                    "Data integrity violation: electronic_order " + order.getId()
+                            + " (correlation " + correlationValue + ") has no linked sample");
+        }
+        if (linkedSamples.size() > 1) {
+            // Nothing in createServiceRequest ever links more than one Sample to the same
+            // correlation -- persistDaherOrderCorrelation links exactly the Sample it just
+            // created. If more than one is observed, trust the database over the assumption,
+            // the same discipline as the fhirOrders.size() > 1 check above.
+            throw new InternalErrorException(
+                    "Data integrity violation: electronic_order " + order.getId()
+                            + " (correlation " + correlationValue + ") has " + linkedSamples.size()
+                            + " linked samples -- expected exactly one");
+        }
+        // Exactly one logical order past this point: one FHIR-typed electronic_order, one
+        // linked Sample. total reflects that -- see the javadoc above for why this is not a
+        // count of the ServiceRequest entries added below.
+        bundle.setTotal(1);
+
+        for (Sample sample : linkedSamples) {
+            if (sample == null || sample.getId() == null) {
+                continue;
+            }
+            List<SampleItem> items = sampleItemService.getSampleItemsBySampleId(sample.getId());
+            if (items == null) {
+                continue;
+            }
+            for (SampleItem item : items) {
+                if (item == null) {
+                    continue;
+                }
+                List<Analysis> analyses = analysisService.getAnalysesBySampleItem(item);
+                if (analyses == null) {
+                    continue;
+                }
+                for (Analysis analysis : analyses) {
+                    if (analysis == null || analysis.getId() == null) {
+                        continue;
+                    }
+                    ServiceRequest resource = fhirTransformService.transformToServiceRequest(analysis.getId());
+                    if (resource == null) {
+                        continue;
+                    }
+                    bundle.addEntry().setResource(resource);
+                }
+            }
+        }
+        return bundle;
+    }
