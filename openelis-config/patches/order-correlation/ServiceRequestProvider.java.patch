+     * no OR/AND combinations -- and returns {@code null} only when the Daher system is absent
+     * entirely, so the caller falls through to the unchanged {@code forwardSearchToFhirStore}
+     * path for every query this patch has no opinion about.
+     *
+     * <p>If the Daher system appears anywhere in a shape this method does not recognize
+     * (combined with another AND term, combined with another system via OR, a blank value),
+     * it fails loud instead of returning {@code null}. Falling through in that case would send
+     * a Daher-system query to the secondary FHIR store, whose sync is best-effort by Finding
+     * B's own premise (a native order can exist while the sync silently failed) -- exactly the
+     * false-ABSENT this patch exists to prevent. DH-025's own query shape (verified against
+     * {@code adapter/src/daher_adapter/openelis.py}'s {@code identifier_search}) always sends
+     * the single-token form, so this path is not expected to be reachable in production; it
+     * exists so a change on either side fails closed instead of silently degrading.
+     */
+    private String extractSingleDaherCorrelationValue(TokenAndListParam identifier) {
+        if (identifier == null) {
+            return null;
+        }
+        boolean daherSystemPresent = identifier.getValuesAsQueryTokens().stream().filter(Objects::nonNull)
+                .flatMap(or -> or.getValuesAsQueryTokens().stream()).filter(Objects::nonNull)
+                .anyMatch(t -> DaherOrderCorrelation.SYSTEM.equals(t.getSystem()));
+        if (!daherSystemPresent) {
+            return null;
+        }
+        if (identifier.size() != 1) {
+            throw new InvalidRequestException("ServiceRequest.identifier combines the "
+                    + DaherOrderCorrelation.SYSTEM + " system with another AND-combined "
+                    + "identifier parameter -- this cannot be resolved unambiguously against "
+                    + "native state");
+        }
+        TokenOrListParam orParam = identifier.getValuesAsQueryTokens().get(0);
+        if (orParam == null || orParam.size() != 1) {
+            throw new InvalidRequestException("ServiceRequest.identifier combines the "
+                    + DaherOrderCorrelation.SYSTEM + " system with another OR-combined token "
+                    + "-- this cannot be resolved unambiguously against native state");
+        }
+        TokenParam token = orParam.getValuesAsQueryTokens().get(0);
+        String value = token == null ? null : token.getValue();
+        if (GenericValidator.isBlankOrNull(value)) {
+            throw new InvalidRequestException(
+                    "ServiceRequest.identifier carries the " + DaherOrderCorrelation.SYSTEM
+                            + " system with a blank value");
+        }
+        return value;
+    }
