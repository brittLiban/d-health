+    /**
+     * DH-011D: persists the Daher order correlation into a dedicated, explicitly FHIR-typed
+     * {@code ElectronicOrder} row (native storage: {@code clinlims.electronic_order
+     * .external_id}, already indexed) and links it to the just-created sample. Deliberately
+     * separate from {@code SamplePatientUpdateData.setElectronicOrderIfNeeded}, which is
+     * shared with the human "external order number" accessioning field and must not gain
+     * silent auto-create behavior as a side effect of this patch.
+     *
+     * <p>Uniqueness: the fast check in {@code createServiceRequest} covers the non-racing
+     * case; the authoritative guarantee is the DB-level partial unique index this patch's
+     * Liquibase changeset adds on {@code electronic_order(external_id) WHERE type = 'FHIR'}. A
+     * genuine race surfaces here as a constraint-violation exception, not a silently accepted
+     * duplicate.
+     *
+     * <p><b>Deliberately does not set {@code sample.referringId}.</b> That field is what
+     * {@code transformToServiceRequest}'s existing, unrelated {@code basedOn}/{@code intent}
+     * logic already keys off (via {@code getElectronicOrdersByExternalId(sample
+     * .getReferringId())}) to decide whether a ServiceRequest is based on a prior one. Setting
+     * it here would make that pre-existing logic treat this opaque correlation value as a FHIR
+     * ServiceRequest reference and misclassify every first-time Daher order as "based on"
+     * something. Linking is done exclusively through {@code sample.clinicalOrderId}, which
+     * that logic does not read; the outbound identifier echo in
+     * {@code FhirTransformServiceImpl.transformToServiceRequest} reads the linked
+     * {@code ElectronicOrder} through that field instead, precisely to avoid this collision.
+     */
+    private void persistDaherOrderCorrelation(String daherOrderId, Sample sample, String sysuserId) {
+        ElectronicOrder electronicOrder = new ElectronicOrder();
+        electronicOrder.setExternalId(daherOrderId);
+        electronicOrder.setData("");
+        electronicOrder.setType(ElectronicOrderType.FHIR);
+        electronicOrder.setStatusId(statusService.getStatusID(ExternalOrderStatus.Realized));
+        electronicOrder.setOrderTimestamp(DateUtil.getNowAsTimestamp());
+        electronicOrder.setSysUserId(sysuserId);
+        String electronicOrderId = electronicOrderService.insert(electronicOrder);
+
+        sample.setClinicalOrderId(electronicOrderId);
+        sample.setSysUserId(sysuserId);
+        sampleService.save(sample);
+    }
