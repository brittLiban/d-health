+    /**
+     * DH-011P Section 9/10, rule C: the added-test namespace's authoritative match. Unlike the
+     * initial-order namespace above, {@code Bundle.total} here is the entry count (always 0 or
+     * 1) rather than a distinct "logical order" count -- one {@code daher_analysis_correlation}
+     * row identifies exactly one {@code Analysis}/event, not every analysis on the accession.
+     *
+     * <p><b>What FOUND means here.</b> {@code analysis_id} is not unique on this table (see
+     * {@code DaherAnalysisCorrelation}'s javadoc): {@code newOrExistingCanceledAnalysis} can
+     * revive a cancelled {@code Analysis} on a later, distinct add-event, so two different
+     * correlations can legitimately point at the same {@code Analysis} across its lifecycle. A
+     * match here proves only "this correlation's add-event targeted this Analysis" -- not that
+     * the Analysis is currently active, uncancelled, or was not itself later retargeted by a
+     * different event. Callers that need the Analysis's current clinical status must read it
+     * from the transformed resource, not infer it from this method returning non-empty.
+     */
+    private Bundle searchAddedTestNamespace(org.openelisglobal.dataexchange.fhir.DaherAnalysisCorrelation correlation,
+            String correlationValue) {
+        Bundle bundle = new Bundle();
+        bundle.setType(Bundle.BundleType.SEARCHSET);
+        bundle.setEntry(new ArrayList<>());
+
+        String analysisId = String.valueOf(correlation.getAnalysisId());
+        Analysis analysis = analysisService.get(analysisId);
+        if (analysis == null || analysis.getId() == null) {
+            // The FK constraint (daher_analysis_correlation.analysis_id -> clinlims.analysis.id,
+            // no ON DELETE cascade) and the fact that OpenELIS never hard-deletes an Analysis
+            // make this unreachable in committed state -- fail loud rather than report zero.
+            throw new InternalErrorException("Data integrity violation: daher_analysis_correlation "
+                    + correlation.getId() + " (correlation " + correlationValue + ") references analysis "
+                    + analysisId + ", which does not exist");
+        }
+
+        ServiceRequest resource = fhirTransformService.transformToServiceRequest(analysisId);
+        if (resource == null) {
+            throw new InternalErrorException(
+                    "Failed to transform analysis " + analysisId + " (correlation " + correlationValue
+                            + ") to ServiceRequest");
+        }
+        bundle.addEntry().setResource(resource);
+        bundle.setTotal(1);
+        return bundle;
+    }
