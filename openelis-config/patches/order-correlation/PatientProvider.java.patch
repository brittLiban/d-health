+    private void attachDaherIdentifierIfLinked(Patient nativePatient, org.hl7.fhir.r4.model.Patient fhirPatient) {
+        if (nativePatient == null || nativePatient.getId() == null || fhirPatient == null) {
+            return;
+        }
+        List<DaherPatientIdentity> links = daherPatientIdentityService.getByPatientId(Long.valueOf(nativePatient.getId()));
+        if (links.isEmpty()) {
+            return;
+        }
+        if (links.size() > 1) {
+            throw new InternalErrorException("Data integrity violation: patient " + nativePatient.getId()
+                    + " carries " + links.size() + " daher_patient_identity rows under system "
+                    + DaherPatientIdentity.SYSTEM + " -- expected at most one");
+        }
+        DaherPatientIdentity link = links.get(0);
+        fhirPatient.addIdentifier(new Identifier().setSystem(link.getIdentifierSystem())
+                .setValue(link.getIdentifierValue()));
+    }
