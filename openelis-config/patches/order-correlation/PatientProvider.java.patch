+    private Bundle searchDaherPatientIdentityNatively(String openmrsPatientUuid)
+            throws FhirTransformationException {
+        List<DaherPatientIdentity> matches = daherPatientIdentityService
+                .getBySystemAndValue(DaherPatientIdentity.SYSTEM, openmrsPatientUuid);
+        if (matches.size() > 1) {
+            throw new InternalErrorException("Data integrity violation: multiple daher_patient_identity rows "
+                    + "share identifier_value " + openmrsPatientUuid
+                    + " -- the uniqueness index should make this impossible");
