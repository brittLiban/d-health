+    /**
+     * DH-011G2: extracts the exactly-one Daher patient-identity identifier from an inbound
+     * Patient. Mandatory on this endpoint -- see the call site in {@code createPatient} for why.
+     * System and value comparisons are exact: no case folding, no substring, no fuzzy matching.
+     * Identifiers on other systems (pat_nationalId, pat_guid, or anything else a caller attaches)
+     * are ignored entirely and never mistaken for this one -- they retain their own native
+     * OpenELIS meanings and are handled unchanged by
+     * {@code FhirTransformServiceImpl.createOePatientManagementInfo}, which this patch does not
+     * touch.
+     */
+    private String extractDaherPatientIdentifier(org.hl7.fhir.r4.model.Patient fhirPatient) {
+        List<Identifier> matches = new ArrayList<>();
+        if (fhirPatient.hasIdentifier()) {
+            for (Identifier identifier : fhirPatient.getIdentifier()) {
+                if (identifier != null && DaherPatientIdentity.SYSTEM.equals(identifier.getSystem())) {
+                    matches.add(identifier);
+                }
+            }
+        }
+        if (matches.isEmpty()) {
+            throw new InvalidRequestException(
+                    "Patient.identifier must carry exactly one " + DaherPatientIdentity.SYSTEM + " identifier "
+                            + "(the OpenMRS Patient UUID) -- found none");
+        }
+        if (matches.size() > 1) {
+            throw new InvalidRequestException("Patient.identifier must carry exactly one "
+                    + DaherPatientIdentity.SYSTEM + " identifier; found " + matches.size());
+        }
+        String value = matches.get(0).getValue();
+        if (StringUtils.isBlank(value)) {
+            throw new InvalidRequestException(
+                    "The " + DaherPatientIdentity.SYSTEM + " identifier value is blank");
+        }
+        try {
+            // DH-011G2 §3/§16: validates shape only (a real OpenMRS UUID, lowercase per
+            // java.util.UUID's own canonical toString() -- OpenMRS generates its UUIDs the same
+            // way). Never validates that the value actually corresponds to a real OpenMRS
+            // patient -- this provider has no way to contact OpenMRS and does not try to; that
+            // trust boundary is the adapter's, which is the only caller of this endpoint.
+            UUID.fromString(value);
+        } catch (IllegalArgumentException e) {
+            throw new InvalidRequestException("The " + DaherPatientIdentity.SYSTEM
+                    + " identifier value is not a well-formed UUID: " + value);
+        }
+        return value;
+    }
+
+    /**
+     * DH-011G2: recognizes exactly the shape the adapter's identifier_search actually sends --
+     * {@code identifier=urn:daher-health:openmrs-patient-uuid|<uuid>}, one system, one value, no
+     * OR/AND combinations -- and returns {@code null} only when the Daher system is absent
+     * entirely, so the caller falls through to the unchanged {@code forwardSearchToFhirStore}
+     * path for every query this patch has no opinion about (pat_nationalId, pat_guid, name,
+     * birthdate, ...).
+     *
+     * <p>If the Daher system appears anywhere in a shape this method does not recognize (combined
+     * with another AND term, combined with another system via OR, a blank value), it fails loud
+     * instead of returning {@code null} -- falling through in that case would send a Daher-system
+     * query to the secondary FHIR store, whose sync is best-effort by this ticket's own premise
+     * (a native Patient can exist while the sync silently failed), exactly the false-ABSENT this
+     * routing exists to prevent. Mirrors ServiceRequestProvider's identical
+     * extractSingleDaherCorrelationValue (DH-011D3).
+     */
+    private String extractSingleDaherPatientIdentifierValue(TokenAndListParam identifier) {
+        if (identifier == null) {
+            return null;
+        }
+        boolean daherSystemPresent = identifier.getValuesAsQueryTokens().stream().filter(Objects::nonNull)
+                .flatMap(or -> or.getValuesAsQueryTokens().stream()).filter(Objects::nonNull)
+                .anyMatch(t -> DaherPatientIdentity.SYSTEM.equals(t.getSystem()));
+        if (!daherSystemPresent) {
+            return null;
+        }
+        if (identifier.size() != 1) {
+            throw new InvalidRequestException("Patient.identifier combines the " + DaherPatientIdentity.SYSTEM
+                    + " system with another AND-combined identifier parameter -- this cannot be resolved "
+                    + "unambiguously against native state");
+        }
+        TokenOrListParam orParam = identifier.getValuesAsQueryTokens().get(0);
+        if (orParam == null || orParam.size() != 1) {
+            throw new InvalidRequestException("Patient.identifier combines the " + DaherPatientIdentity.SYSTEM
+                    + " system with another OR-combined token -- this cannot be resolved unambiguously "
+                    + "against native state");
+        }
+        TokenParam token = orParam.getValuesAsQueryTokens().get(0);
+        String value = token == null ? null : token.getValue();
+        if (StringUtils.isBlank(value)) {
+            throw new InvalidRequestException(
+                    "Patient.identifier carries the " + DaherPatientIdentity.SYSTEM + " system with a blank "
+                            + "value");
+        }
+        return value;
+    }
