# =============================================================================
# OpenELIS common.properties — Daher Health
#
# Upstream's reference file (I-TECH-UW/OpenELIS-Global-2, volume/properties/
# common.properties), fetched 2026-08-11 at DH-005 and kept UNMODIFIED except
# for blanking the upstream outbound mail BCC/from values. Deployment-relevant
# values are annotated inline with `# DAHER:` even where they currently match
# upstream. Diff against the exact upstream tag before assuming anything here
# is our invention.
#
# ⚠️ THIS IS A TEMPLATE, NOT THE DEPLOYED FILE (DH-021). The @NAME@ placeholders
#    below are substituted at deploy time by openelis-config/certs/render-properties.sh
#    into a volume, so the real SSL passwords are never committed. Edit this
#    file, never the rendered output — the rendered copy is overwritten on every
#    `up` and is gitignored.
#
# ⚠️ `encryption.general.password` is deliberately LEFT as upstream's published
#    value. It is NOT part of DH-021. It encrypts application data, so changing
#    it may make already-stored encrypted values unreadable. It needs its own
#    analysis and is potentially clinical-data surface — do not fold it in here.
#
# ⚠️ TWO ITEMS NEED A HUMAN DECISION BEFORE THIS IS USED WITH REAL PATIENTS —
#    both are recorded in PROJECT_STATE.md:
#      1. The default requester is upstream's sample clinician ("Felix
#         Dr. Mauritius"). Left unmodified rather than invented; a real
#         requester identity is the clinical lead's to supply.
#      2. Facility identity fields are empty, exactly as upstream ships them.
#         They are the birth centre's real details and are Liban's to provide.
# =============================================================================

# SSL Config
server.ssl.key-store = file:/etc/openelis-global/keystore
server.ssl.key-store-password = @OE_KEYSTORE_PASSWORD@
server.ssl.key-password = @OE_KEYSTORE_PASSWORD@
server.ssl.trust-store= file:/etc/openelis-global/truststore
server.ssl.trust-store-password=@OE_TRUSTSTORE_PASSWORD@

#/usr/local/tomcat/webapps/OpenELIS-Global/certs
encryption.general.password=kspass

# DAHER: points at this stack's own FHIR container (network alias), not upstream's host.
org.openelisglobal.fhirstore.uri=https://fhir.openelis.org:8443/fhir/
org.openelisglobal.fhirstore.username=
org.openelisglobal.fhirstore.password=
org.openelisglobal.fhir.subscriber.allowHTTP=true

org.openelisglobal.fhir.transformOnStartup=false

#open client registry authentication
org.openelisglobal.crserver.uri=
org.openelisglobal.crserver.username=
org.openelisglobal.crserver.password=

# Remote FHIR server/Consolidated Server
org.openelisglobal.remote.source.uri=
org.openelisglobal.remote.source.updateStatus=true
org.openelisglobal.remote.source.identifier=Practitioner/*
org.openelisglobal.remote.poll.frequency=120000
org.openelisglobal.task.useBasedOn=true

org.openelisglobal.fhir.subscriber=
# Minutes between scheduled retries for failed FHIR exports. Lower values
# give faster recovery from outages but increase load on the partner FHIR
# server. 5 matches the historical default in RegisterFhirHooksTask; tune
# downward only after measuring partner capacity.
org.openelisglobal.fhir.subscriber.backup.interval=5
org.openelisglobal.fhir.subscriber.resources=Task,Patient,ServiceRequest,DiagnosticReport,Observation,Specimen,Practitioner,Encounter

